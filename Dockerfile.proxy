FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx libnginx-mod-stream openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY witdem.yml ./
COPY contracts ./contracts
COPY workflows ./workflows
COPY src ./src
COPY scripts/proxy-entrypoint.sh ./scripts/proxy-entrypoint.sh
COPY scripts/nginx-stream.conf ./scripts/nginx-stream.conf

RUN pip install --no-cache-dir -e . \
    && chmod +x ./scripts/proxy-entrypoint.sh

ENV ONYX_UPSTREAM=http://nginx:80
ENV WITDEM_ENDPOINT=http://host.docker.internal:4318
ENV WITDEM_CONFIG=/app/witdem.yml

EXPOSE 3000 8080 8443

CMD ["./scripts/proxy-entrypoint.sh"]
