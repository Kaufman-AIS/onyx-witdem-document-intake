# Required for Onyx LLM chat (also copied into the upstream Onyx compose .env)
OPENAI_API_KEY=

# Demo client
ONYX_API_BASE_URL=http://127.0.0.1:3001/api
ONYX_API_KEY=
ONYX_PERSONA_ID=
WITDEM_ENDPOINT=http://localhost:4318

# Document intake (real Google APIs)
# Share GOOGLE_DRIVE_ROOT_FOLDER_ID with the service account email (client_email).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_DRIVE_ROOT_FOLDER_ID=
# GOOGLE_TASKS_LIST_ID=
# Tasks on company accounts: use OAuth (SA cannot see personal task lists)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=   # from ./scripts/google-oauth-tasks.sh
# INTAKE_TOOL_URL=http://127.0.0.1:8091/tools/run_intake
# INTAKE_USE_MEMORY=0
# OPENAI_API_KEY=
# ONYX_API_BASE_URL + ONYX_API_KEY (above) are also used by the intake tool
# server to download original chat uploads via GET /chat/file/{file_id}.
